# =====================================================================
# YUI Assistant - Variables de Entorno y Configuración
# =====================================================================

# LLM Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Modo de Operación (development | production | headless)
YUI_ENV="development"
YUI_LOG_LEVEL="INFO"

# Configuración de Audio & Síntesis
YUI_WAKE_WORD="Hey Yui"
YUI_WAKE_WORD_SENSITIVITY=0.6
YUI_STT_MODEL="base" # tiny, base, small, medium, large-v3
YUI_TTS_VOICE="es-CO-SalomeNeural" # es-CO-SalomeNeural, es-ES-ElviraNeural, en-US-AriaNeural
YUI_TTS_RATE="+0%"

# Configuración de Memoria y Vectores
YUI_DATA_DIR="./data"
YUI_VECTOR_DB_PATH="./data/vectors"
YUI_SQLITE_PATH="./data/yui_state.db"

# Seguridad & Automatización de Sistema Operativo
YUI_REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_COMMANDS="true"
YUI_MAX_COMMAND_TIMEOUT_SECONDS=30
